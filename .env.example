# =============================================================================
# CreatorCircle Environment Configuration
# Copy this file to .env.local and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CreatorCircle
NEXT_PUBLIC_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://creatorcircle:creatorcircle@localhost:5432/creatorcircle?schema=public"

# Production database settings
# DB_HOST=your-db-host.rds.amazonaws.com
# DB_PORT=5432
# DB_USER=creatorcircle
# DB_PASSWORD=your-secure-password
# DB_NAME=creatorcircle
# DB_SSL=true

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Kakao OAuth (optional)
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# Naver OAuth (optional)
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Stripe Payments
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe Connect (for creator payouts)
STRIPE_CONNECT_CLIENT_ID=""

# -----------------------------------------------------------------------------
# Redis (for caching and rate limiting)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM=noreply@creatorcircle.io

# SMTP (alternative)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# -----------------------------------------------------------------------------
# Storage (Cloudflare R2 or AWS S3)
# -----------------------------------------------------------------------------
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
# Sentry
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=creatorcircle

# Metrics password (for /api/metrics endpoint)
METRICS_PASSWORD=""

# -----------------------------------------------------------------------------
# CDN (Optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CDN_URL=""

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_REGISTRATION=true
ENABLE_OAUTH=true
ENABLE_PAYMENTS=true
MAINTENANCE_MODE=false

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
